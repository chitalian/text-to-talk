# Copy to .env and fill in your own values. .env is gitignored.
# These are account identifiers, not secrets, but they are personal to your
# Apple/Expo accounts so they are kept out of the repo.

# --- Expo / app identity ---
APP_DISPLAY_NAME="Text to Talk"
EXPO_SLUG=text-to-talk
EXPO_OWNER=your-expo-username
APP_BUNDLE_IDENTIFIER=com.yourname.texttotalk
ANDROID_PACKAGE=com.yourname.texttotalk
EAS_PROJECT_ID=00000000-0000-0000-0000-000000000000

# --- App Store Connect submission (only needed for `eas submit`) ---
# Create an API key at App Store Connect > Users and Access > Integrations.
# Keep the .p8 file OUTSIDE this repo (~/.appstoreconnect/private_keys is the
# standard location). Never commit it.
EXPO_ASC_API_KEY_PATH=/absolute/path/to/AuthKey_XXXXXXXXXX.p8
EXPO_ASC_KEY_ID=XXXXXXXXXX
EXPO_ASC_ISSUER_ID=00000000-0000-0000-0000-000000000000
APPLE_TEAM_ID=XXXXXXXXXX
ASC_APP_ID=0000000000
